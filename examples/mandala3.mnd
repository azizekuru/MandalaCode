// mandala3.mnd
// A multi-ring mandala built from nested repetition and computed geometry.
// Exercises: nested radial_repeat, arithmetic in expressions,
//            inline brush draw, boolean condition in if.

let rings     : int   = 3;
let petals    : int   = 12;
let baseSize  : radius = 15.0;
let increment : radius = 20.0;

pattern buildRing(size : radius, count : int, col : color) {
    radial_repeat(count) {
        draw brush {
            radius: size,
            angle: 360.0 / count,
            color: col
        };
    }
}

buildRing(baseSize, petals, #E63946);
buildRing(baseSize + increment, petals / 2, #457B9D);
buildRing(baseSize + increment * 2.0, petals / 3, #2A9D8F);

let showCenter : bool = true;

if (showCenter == true) {
    draw brush {
        radius: 5.0,
        angle: 0.0,
        color: #F1FAEE
    };
}