// mandala1.mnd
// A simple symmetric mandala with 8 evenly distributed petals.
// Exercises: variable declaration, radial_repeat, assignment,
//            inline brush draw, arithmetic expression.

let r        : radius = 20.0;
let a        : angle  = 0.0;
let segments : int    = 8;

radial_repeat(segments) {
    draw brush {
        radius: r,
        angle:  a,
        color:  #FF4500
    };
    a = a + 45.0;
}